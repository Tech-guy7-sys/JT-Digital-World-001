<Window x:Class="AgentJeff.SecurityCenterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Jeff Security Center" Height="720" Width="980" MinHeight="620" MinWidth="820" Background="#090B16" Foreground="#F4F5FF" WindowStartupLocation="CenterOwner">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,18"><Border Background="#252A4A" CornerRadius="10" Padding="10"><TextBlock Text="JT" FontSize="19" FontWeight="Bold" Foreground="#AEB5FF"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Jeff Security Center" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="WINDOWS PROTECTION · SCANS · ACTION APPROVALS" Foreground="#A4A9C5" FontSize="11"/></StackPanel></DockPanel>
    <Border Grid.Row="1" Background="#15182B" CornerRadius="16" Padding="16" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MICROSOFT DEFENDER" Foreground="#AEB5FF" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="ProtectionStatus" Text="Status not checked" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,4"/><TextBlock x:Name="ProtectionDetails" Text="Check Defender status to view real-time protection and signature information." Foreground="#B6BAD1" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Check status" Click="CheckStatus_Click" Padding="18,10" Background="#929BFF" Foreground="#101326" BorderThickness="0" VerticalAlignment="Center"/></Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <Border Background="#15182B" CornerRadius="16" Padding="16"><StackPanel><TextBlock Text="SCAN &amp; SCHEDULE" FontSize="12" Foreground="#AEB5FF" FontWeight="SemiBold"/><TextBlock Text="ClamAV engine + local triage + Windows protection" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,12"/><Button Content="Analyze a file · hash + heuristics" Click="AnalyzeFile_Click" Height="40" Background="#292F50" Foreground="White" BorderThickness="0"/><Button Content="Scan a folder · create report" Click="ScanFolder_Click" Height="40" Margin="0,8,0,0" Background="#292F50" Foreground="White" BorderThickness="0"/><TextBlock x:Name="EngineStatus" Text="Local triage checks SHA-256 and a small set of transparent heuristics; it is not a malware signature engine." Foreground="#B6BAD1" TextWrapping="Wrap" Margin="0,8,0,8" FontSize="11"/><Button Content="ClamAV scan · selected file" Click="ClamAvFileScan_Click" Height="40" Background="#39466F" Foreground="White" BorderThickness="0"/><Button Content="ClamAV scan · folder" Click="ClamAvFolderScan_Click" Height="40" Margin="0,8,0,8" Background="#39466F" Foreground="White" BorderThickness="0"/><Button Content="Request Defender scan of a file" Click="DefenderFileScan_Click" Height="40" Background="#292F50" Foreground="White" BorderThickness="0"/><Button Content="Run Defender quick scan" Click="QuickScan_Click" Height="42" Background="#929BFF" Foreground="#101326" BorderThickness="0" FontWeight="SemiBold"/><Button Content="Schedule daily quick scan · 2:00 AM" Click="ScheduleScan_Click" Height="40" Margin="0,9,0,0" Background="#292F50" Foreground="White" BorderThickness="0"/><TextBlock x:Name="ScanStatus" Text="No scan requested in this session." Foreground="#B6BAD1" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
        <Border Background="#15182B" CornerRadius="16" Padding="16" Margin="0,14,0,0"><StackPanel><TextBlock Text="SYSTEM HEALTH CHECKS" FontSize="12" Foreground="#AEB5FF" FontWeight="SemiBold"/><TextBlock Text="Read-only Windows diagnostics" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,12"/><ComboBox x:Name="DiagnosticPicker" Height="36" Background="#20243A" Foreground="#17192A"><ComboBoxItem Content="Network configuration (ipconfig /all)" Tag="ipconfig"/><ComboBoxItem Content="Windows image health (DISM CheckHealth)" Tag="dism"/><ComboBoxItem Content="System file verification (SFC verifyonly)" Tag="sfc"/></ComboBox><Button Content="Review &amp; request permission" Click="Diagnostic_Click" Height="40" Margin="0,9,0,0" Background="#292F50" Foreground="White" BorderThickness="0"/><TextBlock Text="These checks are read-only; results open in a separate window. No free-form shell command execution." Foreground="#B6BAD1" TextWrapping="Wrap" Margin="0,9,0,0" FontSize="11"/></StackPanel></Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,0,0">
        <Border Background="#15182B" CornerRadius="16" Padding="16"><StackPanel><TextBlock Text="APPROVAL QUEUE" FontSize="12" Foreground="#AEB5FF" FontWeight="SemiBold"/><TextBlock Text="You stay in control" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,8"/><TextBlock Text="Actions must show the exact program or task, the reason, and a risk note before you approve. Denying an action does not affect protection." Foreground="#B6BAD1" TextWrapping="Wrap" LineHeight="21"/><Button Content="Choose a program to launch…" Click="LaunchProgram_Click" Height="40" Margin="0,12,0,0" Background="#292F50" Foreground="White" BorderThickness="0"/><TextBlock x:Name="ApprovalStatus" Text="No pending approval." Foreground="#B6BAD1" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
        <Border Background="#15182B" CornerRadius="16" Padding="16" Margin="0,14,0,0"><StackPanel><TextBlock Text="SYSTEM FINDINGS" FontSize="12" Foreground="#AEB5FF" FontWeight="SemiBold"/><TextBlock Text="Defender reports and status" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,8"/><TextBlock Text="Jeff will show information returned by Windows security tools. It does not currently provide an independent antivirus engine, continuous file monitoring, or guaranteed threat detection." Foreground="#B6BAD1" TextWrapping="Wrap" LineHeight="21"/><Button Content="Open Windows Security" Click="OpenWindowsSecurity_Click" Height="38" Margin="0,12,0,0" Background="#292F50" Foreground="White" BorderThickness="0"/></StackPanel></Border>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="3" Text="Safety: Defender scan scheduling may require Windows administrator approval. Jeff never disables Defender or silently removes files. Voice recognition alone is not authorization." Foreground="#858BAA" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="11"/>
  </Grid>
</Window>