<Window x:Class="AgentJeff.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Agent Jeff · JT Digital World" Height="760" Width="1060" MinHeight="650" MinWidth="850" Background="#090B16" Foreground="#F4F5FF" WindowStartupLocation="CenterScreen">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,22">
      <Border Background="#252A4A" CornerRadius="12" Padding="12" DockPanel.Dock="Left"><TextBlock Text="JT" FontSize="20" FontWeight="Bold" Foreground="#AEB5FF"/></Border>
      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Agent Jeff" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="DESKTOP ASSISTANT · VOICE CONSOLE" Foreground="#A4A9C5" FontSize="11" Margin="0,3,0,0"/></StackPanel>
      <Border Background="#162C2A" CornerRadius="12" Padding="12,7" HorizontalAlignment="Right"><TextBlock x:Name="StatusText" Text="READY · MICROPHONE OFF" Foreground="#77E2C2" FontSize="11" FontWeight="SemiBold"/></Border>
    </DockPanel>
    <Border Grid.Row="1" Background="#15182B" CornerRadius="18" Padding="20" Margin="0,0,0,18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="Talk naturally. Keep control." FontSize="22" FontWeight="SemiBold"/><TextBlock Text="This Windows app uses installed Windows speech components. Listening starts only when you press the button; nothing is recorded in the background." TextWrapping="Wrap" Foreground="#B6BAD1" Margin="0,8,0,0" LineHeight="22"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="ASSISTANT VOICE" Foreground="#A4A9C5" FontSize="11" Margin="0,0,0,7"/><ComboBox x:Name="VoicePicker" Height="36" Background="#20243A" Foreground="#17192A" SelectionChanged="VoicePicker_SelectionChanged"/><Button Content="Preview voice" Click="PreviewVoice_Click" Margin="0,9,0,0" Height="34" Background="#292F50" Foreground="White" BorderThickness="0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
      <Border Background="#15182B" CornerRadius="18" Padding="20" Margin="0,0,10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="VOICE INPUT" FontSize="12" FontWeight="SemiBold" Foreground="#AEB5FF"/><TextBlock Text="Speak and review your words" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
        <TextBox x:Name="TranscriptBox" Grid.Row="1" Margin="0,16,0,16" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0D1020" Foreground="#F4F5FF" BorderBrush="#2C3150" Padding="14" FontSize="15" Text="Your recognized speech will appear here. Review it before using it."/>
        <WrapPanel Grid.Row="2"><Button x:Name="ListenButton" Content="Start listening" Click="Listen_Click" Padding="18,10" Background="#929BFF" Foreground="#101326" BorderThickness="0" FontWeight="SemiBold"/><Button Content="Stop" Click="Stop_Click" Padding="18,10" Margin="8,0,0,0" Background="#292F50" Foreground="White" BorderThickness="0"/><Button Content="Clear" Click="Clear_Click" Padding="18,10" Margin="8,0,0,0" Background="#292F50" Foreground="White" BorderThickness="0"/></WrapPanel>
      </Grid></Border>
      <StackPanel Grid.Column="1" Margin="10,0,0,0">
        <Border Background="#15182B" CornerRadius="18" Padding="20"><StackPanel><TextBlock Text="VOICE PROFILE &amp; SECURITY" Foreground="#AEB5FF" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Honest status" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,12"/><TextBlock Text="Speaker verification is not implemented yet. This companion is a desktop overlay only; Windows prevents ordinary apps from drawing over the secure sign-in lock screen. Voice enrollment remains disabled until a real speaker-verification model is integrated." TextWrapping="Wrap" Foreground="#C4C7DA" LineHeight="22"/><Border Background="#302719" CornerRadius="10" Padding="12" Margin="0,15,0,0"><TextBlock Text="Not enrolled · Speaker verification OFF" TextWrapping="Wrap" Foreground="#FFD38A" FontSize="12"/></Border><Button Content="Show desktop companion" Click="ShowCompanion_Click" Height="40" Margin="0,12,0,0" Background="#929BFF" Foreground="#101326" BorderThickness="0" FontWeight="SemiBold"/><Button Content="Open Jeff Security Center" Click="OpenSecurity_Click" Height="40" Margin="0,8,0,0" Background="#292F50" Foreground="White" BorderThickness="0"/><TextBlock Text="Always on top after sign-in · user can stop or hide it" Foreground="#B6BAD1" TextWrapping="Wrap" Margin="0,7,0,0" FontSize="11"/></StackPanel></Border>
        <Border Background="#15182B" CornerRadius="18" Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="SPEAK TEXT" Foreground="#AEB5FF" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Play your reviewed transcript" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,10"/><TextBlock Text="This uses the selected voice installed on Windows." Foreground="#B6BAD1" TextWrapping="Wrap" Margin="0,0,0,12"/><Button Content="Speak transcript" Click="SpeakTranscript_Click" Height="40" Background="#292F50" Foreground="White" BorderThickness="0"/><Button Content="Stop speaking" Click="StopSpeaking_Click" Height="38" Margin="0,8,0,0" Background="#292F50" Foreground="White" BorderThickness="0"/></StackPanel></Border>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="3" Text="Privacy: microphone use is user-started. Speech processing uses Windows speech services available on this PC. This build does not save audio or implement speaker biometrics. The companion cannot appear over the secure Windows lock screen." Foreground="#858BAA" TextWrapping="Wrap" Margin="0,18,0,0" FontSize="11"/>
  </Grid>
</Window>